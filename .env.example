APP_ENV=development
APP_NAME=RedTag API
API_HOST=0.0.0.0
API_PORT=8080
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://redtag:redtag@postgres:5432/redtag
JWT_ISSUER=redtag-local
JWT_AUDIENCE=redtag-api
JWT_ALGORITHM=HS256
JWT_SECRET=change-me-in-production
JWKS_URL=
OIDC_EMAIL_CLAIM=email
AUTH_MODE=dev
DEFAULT_TENANT_ID=tenant_demo
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
GCS_EVIDENCE_BUCKET=
PUBSUB_TOPIC=redtag-domain-events
PUBSUB_SUBSCRIPTION=redtag-domain-worker
PUBSUB_ENABLED=false
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_FAIL_CLOSED=true
REAL_AI_ENABLED=false
REAL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=safety@redtag.local
NOTIFICATION_WEBHOOK_URL=
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Web server/BFF authentication and upstream API
REDTAG_AUTH_MODE=dev
REDTAG_API_URL=http://localhost:8080/api/v1
REDTAG_DEFAULT_TENANT_ID=tenant_demo

# Build-time Firebase / Google Identity Platform config for production web images
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_TENANT_ID=tenant_demo
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
